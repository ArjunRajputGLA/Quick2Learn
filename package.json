{
  "name": "quick2learn",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts --check",
    "postinstall": "node scripts/patch-css-interop.js",
    "mobile:start": "pnpm --filter mobile start",
    "mobile:clean": "pnpm --filter mobile start --clear",
    "mobile:android": "pnpm --filter mobile android",
    "mobile:typecheck": "pnpm --filter mobile typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:up": "node scripts/db-up.cjs",
    "db:down": "node scripts/db-down.cjs",
    "db:generate": "pnpm --filter @quick2learn/db generate",
    "db:migrate": "pnpm --filter @quick2learn/db migrate",
    "db:seed": "pnpm --filter @quick2learn/db seed",
    "db:seed:prod": "pnpm --filter @quick2learn/db seed:prod",
    "db:studio": "pnpm --filter @quick2learn/db studio",
    "db:reset": "node scripts/db-reset.cjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:storage": "pnpm --filter @quick2learn/db exec tsx ../../scripts/test-storage.ts",
    "admin:promote": "pnpm --filter @quick2learn/db exec tsx ../../scripts/admin-promote.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "expo": "~58.0.14",
    "pg": "^8.13.3",
    "prettier": "^3.5.3",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "xlsx": "^0.18.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "better-sqlite3",
      "esbuild",
      "core-js",
      "unrs-resolver"
    ]
  }
}