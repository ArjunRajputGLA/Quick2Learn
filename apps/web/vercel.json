{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "quick2learn.vercel.app" }],
      "destination": "https://quick2learn.in/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/youtube-sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/payment-housekeeping",
      "schedule": "0 2 * * *"
    }
  ]
}
