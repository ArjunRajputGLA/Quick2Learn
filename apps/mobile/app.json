{
  "expo": {
    "name": "Quick2Learn",
    "slug": "quick2learn",
    "owner": "arjun2k4",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "q2l",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF",
      "translucent": true
    },
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EFF6FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.quick2learn.app"
    },
    "android": {
      "package": "in.quick2learn.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EFF6FF"
      },
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "quick2learn.in",
              "pathPrefix": "/lecture"
            },
            {
              "scheme": "https",
              "host": "quick2learn.in",
              "pathPrefix": "/batch"
            },
            {
              "scheme": "https",
              "host": "quick2learn.in",
              "pathPrefix": "/test"
            },
            {
              "scheme": "https",
              "host": "quick2learn.in",
              "pathPrefix": "/doubt"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EFF6FF"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "quick2learn",
          "project": "mobile-app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8dce3b27-2fbe-423a-96a0-e0e3a1d2c293"
      }
    }
  }
}
