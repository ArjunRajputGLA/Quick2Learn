{
  "expo": {
    "name": "Quick2Learn",
    "slug": "quick2learn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "q2l",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EFF6FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.quick2learn.app"
    },
    "android": {
      "package": "in.quick2learn.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EFF6FF"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EFF6FF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
